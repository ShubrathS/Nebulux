# Nebulux — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# === Anthropic / Claude ===
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# === Google / Gemini ===
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# === Kimi K2.6 ===
# Either point at a local NIM container or at NVIDIA's hosted endpoint.
# Local NIM:    KIMI_URL=http://localhost:8000   (no key needed)
# NVIDIA hosted: KIMI_URL=https://integrate.api.nvidia.com   + nvapi key below
KIMI_URL=http://localhost:8000
KIMI_API_KEY=

# === Ollama / Gemma (local) ===
# `ollama list` to see what you have; default expects `gemma4:latest`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# === Server ===
PORT=3000
# Comma-separated allowlist of origins permitted to call the API (production).
# Leave blank to allow same-origin only. Use "*" for fully open (dev only).
CORS_ORIGIN=
NODE_ENV=development
